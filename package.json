{
  "name": "srn-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:backend\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:backend": "npm run dev --workspace=apps/backend-nest",
    "dev:api": "npm run dev --workspace=apps/backend-nest",
    "install:all": "npm install"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "concurrently": "^8.2.2"
  }
}
