# В разработке все запросы идут через Vite proxy (localhost:5173/api → 192.0.2.17:9001/api)
# CORS не нужен — браузер видит один и тот же хост
VITE_API_URL=/api
VITE_FILE_URL=/api
VITE_PARTNER_CREATE_RESTRICTED=true

# Адрес бэкенда (используется только Vite proxy, не браузером)
# При смене IP бэкенда — поменять только здесь и в vite.config.js
