# Copy to .env.development / .env.production (or use Vite defaults).
# Files .env, .env.development, .env.production are gitignored — do not commit real values.

# Backend API base (browser). Default in code: /api
# VITE_API_URL=http://localhost:9001/api

# Public URL for file downloads (optional). Default: same as API base
# VITE_FILE_URL=http://localhost:9001/api

# Restrict partner creation UI (mirrors backend PARTNER_CREATE_RESTRICTED)
# VITE_PARTNER_CREATE_RESTRICTED=true
