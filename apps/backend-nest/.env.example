
NODE_ENV=development

DATABASE_URL=postgresql://user:password@localhost:5432/dbname
JWT_SECRET=change-me-long-random-string

PORT=9001
FRONTEND_URL=http://localhost:5173

# Публичный URL API для ссылок на файлы (UI, Excel). На stage/prod — адрес, доступный всем пользователям.
# Пример stage: http://192.0.2.12:3002/api
# Пример prod:  http://192.0.2.12:3001/api
FILE_UPLOAD_URL=http://localhost:9001/api

# Подпись ссылок на файлы в Excel (prod по умолчанию включена). Dev: FILE_LINK_SIGNING=false
# FILE_LINK_TTL_SEC=31536000

UPLOAD_PATH=./uploads

# Внешний files-service (HTTP). Пусто = только локальный UPLOAD_PATH (legacy).
# Локально: поднять ecrt/files-service.
# Ключ выпускать в files-service: docker compose run --rm meta npm run key:issue -- --consumer pmdb --name "pmdb backend"
# FILES_API_KEYS из files-service/.env тоже сработает (потребитель legacy), но изоляции между сервисами не будет.
# FILES_SERVICE_URL=http://127.0.0.1:3080
# FILES_API_KEY=

THESIS_DB_URL=***REDACTED***
PARTNER_SYNC_INTERVAL_MINUTES=15
PARTNER_CREATE_RESTRICTED=true

# OnlyOffice Document Server (общий сервис platform/onlyoffice).
# Пример stage: http://192.0.2.12:8090
ONLYOFFICE_URL=http://localhost:8090
# Секрет подписи JWT между бэкендом и Document Server (отдельный от JWT_SECRET).
# Должен совпадать с platform/onlyoffice/.env и бэкендом портала того же контура.
ONLYOFFICE_JWT_SECRET=***REDACTED***


