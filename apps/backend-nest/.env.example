# Copy to .env and/or .env.development in this directory (see app.module ConfigModule).
# Real .env files are gitignored — do not commit secrets.

NODE_ENV=development

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
JWT_SECRET=change-me-long-random-string

# HTTP (main.ts)
PORT=9001
# Comma-separated origins for CORS
FRONTEND_URL=http://localhost:5173

# Files module (optional overrides)
# UPLOAD_PATH=./uploads
# API_URL=http://localhost:9001/api
# FILE_UPLOAD_URL=http://localhost:9001/api

# Mail (optional; mail.service has defaults for local dev)
# SMTP_FROM=
# SMTP_HOST=
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# External INN lookup (optional)
# DATANEWTON_API_KEY=

# Синхронизация пользователей из внешнего HR API (GET JSON с полем data[])
# EXTERNAL_HR_USERS_URL=http://192.0.2.12:3000/api/sync/pmdb-users
# EXTERNAL_HR_API_TOKEN=
# Базовый URL для относительных avatar_url из HR (без завершающего /)
# EXTERNAL_HR_ASSET_BASE_URL=http://192.0.2.12:3000
# Секрет для POST /api/hr-sync/users (заголовок X-HR-Sync-Secret)
# HR_USERS_SYNC_SECRET=generate-long-random-string
# Интервал автосинхронизации с HR (минуты). 0 — отключить. По умолчанию 15, если переменная не задана.
# HR_SYNC_INTERVAL_MINUTES=15
